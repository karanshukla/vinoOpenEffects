[Unit]
Description=vinoOpenEffects webcam effects daemon
After=pipewire.service wireplumber.service graphical-session.target
Requires=pipewire.service

[Service]
Type=dbus
BusName=io.github.karanshukla.vinoopeneffects.Daemon
ExecStart=@bindir@/vinoopeneffects-daemon --start
Restart=on-failure
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
RestrictSUIDSGID=yes

[Install]
WantedBy=graphical-session.target
